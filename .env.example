# -----------------------------------------------------------------------------
# Kronoplay — configurazione ambiente
# -----------------------------------------------------------------------------
# 1. Copia questo file in ".env"  ->  cp .env.example .env
# 2. Incolla la tua API key TMDB (v3) qui sotto, al posto del placeholder.
#    La ottieni gratis da: https://www.themoviedb.org/settings/api
#
# NOTA: il prefisso EXPO_PUBLIC_ è obbligatorio. Expo (SDK 49+) espone
# automaticamente solo le variabili con questo prefisso a process.env nel
# bundle client. Dopo aver modificato il .env riavvia Expo con `npx expo start -c`
# per svuotare la cache.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_TMDB_API_KEY=INCOLLA_QUI_LA_TUA_API_KEY_TMDB
